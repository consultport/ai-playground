<%= turbo_frame_tag "user-tags" do %>
  <div class="bg-white border border-[#dee2e6] rounded-[4px] p-4">
    <h2 class="text-[15px] leading-[17px] font-bold text-gray-900 mb-3">Internal tags</h2>

    <div class="relative"
         data-controller="tag-input"
         data-tag-input-search-url-value="<%= admin_tags_path %>"
         data-tag-input-create-url-value="<%= admin_user_tags_path(user) %>"
         data-tag-input-destroy-url-template-value="<%= admin_user_tag_path(user, "__TAG_ID__") %>"
         data-tag-input-applied-tag-ids-value="<%= user.tags.pluck(:id).to_json %>"
         data-tag-input-csrf-value="<%= form_authenticity_token %>">
      <div data-tag-input-target="field"
           class="flex flex-wrap items-center gap-[6px] min-h-[36px] bg-white border border-[#dee2e6] rounded-[4px] px-2 py-1 cursor-text focus-within:outline-none focus-within:ring-2 focus-within:ring-[#2e6fe3]/30"
           data-action="click->tag-input#focusInput">
        <div data-tag-input-target="pillsContainer" class="contents">
          <% user.user_tags.includes(:tag).order("tags.name").each do |user_tag| %>
            <%= render "admin/users/tags/pill", tag: user_tag.tag %>
          <% end %>
        </div>
        <input type="text"
               data-tag-input-target="input"
               data-action="input->tag-input#type focus->tag-input#focus keydown->tag-input#keydown"
               placeholder="<%= user.tags.empty? ? "Add a tag…" : "" %>"
               autocomplete="off"
               class="flex-1 min-w-[80px] border-0 outline-none bg-transparent text-[14.4px] leading-[21.6px] text-gray-900 placeholder:text-[#adb5bd]">
      </div>

      <div data-tag-input-target="dropdown"
           class="hidden absolute left-0 right-0 top-full z-10 bg-white border border-[#dee2e6] border-t-0 rounded-b-[4px] shadow-[0_0_45px_rgba(108,117,125,0.15)] max-h-60 overflow-y-auto">
        <ul data-tag-input-target="results" class="py-1"></ul>
      </div>
    </div>
  </div>
<% end %>
