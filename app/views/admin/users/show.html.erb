<%= link_to "Back to users", admin_users_path, class: "text-sm text-indigo-600 hover:text-indigo-900" %>

<div class="mt-4 bg-white rounded-xl shadow-sm border border-gray-200 p-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= @user.name %></h1>

  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500">Email</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @user.email %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Role</dt>
      <dd class="mt-1">
        <% if @user.admin? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">admin</span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">user</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Confirmed</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @user.confirmed? ? "Yes" : "No" %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Joined</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @user.created_at.strftime("%b %d, %Y") %></dd>
    </div>
  </dl>

  <div class="mt-8">
    <%= render "admin/users/tags/frame", user: @user %>
  </div>

  <div class="mt-8 flex items-center gap-4">
    <%= link_to "Edit", edit_admin_user_path(@user), class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors" %>
    <% unless @user == current_user %>
      <%= button_to "Delete", admin_user_path(@user), method: :delete, class: "rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors cursor-pointer", form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } } %>
    <% end %>
  </div>
</div>
