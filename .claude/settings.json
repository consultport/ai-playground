{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bin/lint-file",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "if": "Bash(git commit *)",
            "type": "command",
            "command": "bin/rubocop >&2 || exit 2",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
